{
  "name": "fetchit",
  "displayName": "FetchIt",
  "repository": {
    "type": "git",
    "url": "https://github.com/Willi-js/FetchIt"
  },
  "description": "Navigate your files faster with out lifting your hands from your keyboard using FetchIt!!!",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fetchit.fetchlist",
        "title": "Fetch List"
      },
      {
        "command": "fetchit.addfetch",
        "title": "Add Fetch"
      },
      {
        "command": "fetchit.selectnext",
        "title": "Select Next"
      },
      {
        "command": "fetchit.selectprevious",
        "title": "Select Previous"
      },
      {
        "command": "fetchit.clearall",
        "title": "Clear All"
      }
    ],
    "keybindings": [
      {
        "command": "fetchit.fetchlist",
        "key": "alt+e",
        "mac": "alt+e"
      },
      {
        "command": "fetchit.addfetch",
        "key": "alt+a",
        "mac": "alt+a"
      },
      {
        "command": "fetchit.selectnext",
        "key": "ctrl+]",
        "mac": "cmd+]"
      },
      {
        "command": "fetchit.selectprevious",
        "key": "ctrl+[",
        "mac": "cmd+["
      },
      {
        "command": "fetchit.clearall",
        "key": "alt+r",
        "mac": "alt+r"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
